# ==============================================================================
# MARIS – RCYC Guest Concierge Configuration
# ==============================================================================

PORT=8000
LOG_LEVEL=INFO

# Data Provider & Demo Configuration
# Options: mock (reads local sample_data.json) | informatica
DATA_PROVIDER_MODE=mock
DEMO_MODE=true
SAMPLE_DATA_JSON=data/sample_data.json
# Comma-separated CORS origins; empty (default) enforces same-origin only (no CORS headers)
ALLOWED_ORIGINS=

# Informatica Business 360 & Session Configuration (names only; set via Secrets)
INFA_LOGIN_URL=
INFA_USERNAME=
INFA_PASSWORD=
INFA_ENTITY=guest360
INFA_GUEST_ID_FIELD=
INFA_CUSTOMER_ID_FIELD=rcyc_id
INFA_MODEL_VERSION=
INFA_TIMEOUT_SECONDS=
INFA_CACHE_SECONDS=
INFA_MAX_BOOKINGS=
# Optional Informatica Guest360 field paths (group.field or field; empty = skipped)
INFA_FIELD_LOYALTY_TIER=
INFA_FIELD_PREFERRED_REGIONS=
INFA_FIELD_PREFERRED_SUITE=
INFA_FIELD_INTEREST_FOCUS=
INFA_FIELD_CONSENT=
INFA_FIELD_VIP=
INFA_FIELD_OPEN_COMPLAINT=
# Demo switch only: when true and INFA_FIELD_CONSENT is empty, assume personalization consent = Y
DEMO_ASSUME_PERSONALIZATION_CONSENT=false
SECRET_KEY=
DEMO_PASSWORD=

# AI / LLM Configuration
# Options: rule_based | gemini | ollama | anthropic
# Note: When GEMINI_API_KEY is set on the server, Gemini phrasing runs strictly
# server-side (using a ListModels-verified generateContent model) and silently
# falls back to rule_based on failure.
LLM_PROVIDER=rule_based
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Ollama Configuration (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Anthropic Configuration (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
